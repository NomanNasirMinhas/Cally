<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="MenuSurface" Color="#111D33"/>
  <SolidColorBrush x:Key="MenuStroke" Color="#42516D"/>
  <SolidColorBrush x:Key="MenuInk" Color="#F2F5FF"/>
  <SolidColorBrush x:Key="MenuAccent" Color="#BAC6FF"/>
  <Style x:Key="CallyRow" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource MenuInk}"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,5" MinHeight="30">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <ContentPresenter x:Name="Glyph" ContentSource="Icon" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <TextBlock x:Name="Mark" Grid.Column="2" Foreground="{DynamicResource MenuAccent}" HorizontalAlignment="Right"/>
            <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=Row}" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
              <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="180"><ScrollViewer MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},Path=Height}" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
            </Popup>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="HasItems" Value="True"><Setter TargetName="Mark" Property="Text" Value="›"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Text" Value="✓"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#334669"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CallyMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Background="{DynamicResource MenuSurface}" BorderThickness="1" BorderBrush="{DynamicResource MenuStroke}" CornerRadius="12" Padding="6" MinWidth="232">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,5,8,7"><Image Source="Assets/Cally.ico" Width="24" Height="24"/><TextBlock Text="Cally" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MenuInk}" Margin="9,0" VerticalAlignment="Center"/></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </DockPanel>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>

