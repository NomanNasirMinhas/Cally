<Window x:Class="Cally.Widget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cally" Width="430" MinWidth="375" MaxWidth="900" MinHeight="190" MaxHeight="850" Height="440" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F3F6FF" FontSize="14">

<Grid><Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition/></Grid.RowDefinitions><Grid Height="126" Cursor="SizeAll" MouseLeftButtonDown="StartMove" Background="Transparent">
<Border Margin="19,6,1,6" Background="#F209152A" BorderBrush="#475878" BorderThickness="1" CornerRadius="20"/>
<Grid Margin="139,12,16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="19" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Sub" Margin="0,7,4,0" Foreground="#BFCAF3" TextTrimming="CharacterEllipsis"/></StackPanel>
<Button x:Name="HeroJoin" Grid.Column="1" VerticalAlignment="Center" Content="Join" Click="Join" Style="{StaticResource Action}"/></Grid>
<Grid Width="124" Height="124" HorizontalAlignment="Left"><Ellipse Fill="#091830" Stroke="#415577" StrokeThickness="2"/><Ellipse Margin="7" Stroke="#253959" StrokeThickness="7"/><Path x:Name="Arc" Stroke="#8983FF" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Count" FontSize="40" HorizontalAlignment="Center"/><TextBlock x:Name="Unit" Foreground="#BEC9F4" HorizontalAlignment="Center"/></StackPanel></Grid>
</Grid>
<Border Grid.Row="1" Margin="19,2,1,2" Background="#F0101C34" BorderBrush="#465673" BorderThickness="1" CornerRadius="15" Padding="9">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Background="Transparent" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" AutomationProperties.Name="Refresh all calendars" ToolTip="Refresh all calendars now" Click="RefreshClicked"/><Button x:Name="Scope" DockPanel.Dock="Right" Style="{StaticResource Action}" Background="Transparent" Click="Menu" ToolTip="Filter accounts and manage Cally"/><Button ToolTip="Expand or collapse the agenda" x:Name="Today" HorizontalAlignment="Left" Style="{StaticResource Action}" Background="Transparent" Click="Toggle"/></DockPanel>
<ScrollViewer x:Name="Panel" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Rows"/></ScrollViewer>
<Button Grid.Row="2" x:Name="UpdateLink" Visibility="Collapsed" HorizontalAlignment="Left" Margin="3,4" Style="{StaticResource Action}" Background="#304264" Click="OpenRelease" ToolTip="Open the latest Cally release on GitHub"/><TextBlock Grid.Row="3" x:Name="Status" Foreground="#C1CEEB" FontSize="12" Margin="8,4" TextWrapping="Wrap"/>
</Grid></Border><Thumb Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNWSE" ToolTip="Drag to resize" DragDelta="ResizeWidget" DragCompleted="FinishResize"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" Foreground="#ABB7DA" HorizontalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Grid></Window>



