<Window x:Class="Cally.Widget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cally" Width="430" MinWidth="375" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F3F6FF" FontSize="14">

<StackPanel>
<Grid Height="126" Cursor="SizeAll" MouseLeftButtonDown="StartMove" Background="Transparent">
<Border Margin="19,6,1,6" Background="#F209152A" BorderBrush="#475878" BorderThickness="1" CornerRadius="20"/>
<Grid Margin="139,12,16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="19" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Sub" Margin="0,7,4,0" Foreground="#BFCAF3" TextTrimming="CharacterEllipsis"/></StackPanel>
<Button x:Name="HeroJoin" Grid.Column="1" VerticalAlignment="Center" Content="Join" Click="Join" Style="{StaticResource Action}"/></Grid>
<Grid Width="124" Height="124" HorizontalAlignment="Left"><Ellipse Fill="#091830" Stroke="#415577" StrokeThickness="2"/><Ellipse Margin="7" Stroke="#253959" StrokeThickness="7"/><Path x:Name="Arc" Stroke="#8983FF" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Count" FontSize="40" HorizontalAlignment="Center"/><TextBlock x:Name="Unit" Foreground="#BEC9F4" HorizontalAlignment="Center"/></StackPanel></Grid>
</Grid>
<Border Margin="19,2,1,2" Background="#F0101C34" BorderBrush="#465673" BorderThickness="1" CornerRadius="15" Padding="9">
<StackPanel><DockPanel><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Background="Transparent" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" AutomationProperties.Name="Refresh all calendars" ToolTip="Refresh all calendars now" Click="RefreshClicked"/><Button x:Name="Scope" DockPanel.Dock="Right" Style="{StaticResource Action}" Background="Transparent" Click="Menu" ToolTip="Filter accounts and manage Cally"/><Button ToolTip="Expand or collapse the agenda" x:Name="Today" HorizontalAlignment="Left" Style="{StaticResource Action}" Background="Transparent" Click="Toggle"/></DockPanel>
<ScrollViewer x:Name="Panel" MaxHeight="370" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Rows"/></ScrollViewer>
<TextBlock x:Name="Status" Foreground="#C1CEEB" FontSize="12" Margin="8,4" TextWrapping="Wrap"/>
</StackPanel></Border></StackPanel></Window>

